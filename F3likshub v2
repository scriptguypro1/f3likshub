local function buildScriptFromPrompt(rawPrompt)
	local q = string.lower(tostring(rawPrompt or ""))
	if string.find(q, "fly") or string.find(q, "float") or string.find(q, "hover") then
		return table.concat({
			"-- Built by f3liks hub AI Builder",
			"local Players = game:GetService('Players')",
			"local RunService = game:GetService('RunService')",
			"local lp = Players.LocalPlayer",
			"local hovering = true",
			"local conn",
			"conn = RunService.Heartbeat:Connect(function()",
			"\tif not hovering then return end",
			"\tlocal char = lp.Character",
			"\tlocal hrp = char and char:FindFirstChild('HumanoidRootPart')",
			"\tlocal hum = char and char:FindFirstChildOfClass('Humanoid')",
			"\tif hrp and hum then",
			"\t\thrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 2.5, hrp.AssemblyLinearVelocity.Z)",
			"\tend",
			"end)",
			"print('[f3liks hub] Hover active. Set hovering = false to stop.')"
		}, "\n")
	elseif string.find(q, "esp") or string.find(q, "highlight") or string.find(q, "part") then
		return table.concat({
			"-- Built by f3liks hub AI Builder",
			"local Players = game:GetService('Players')",
			"local lp = Players.LocalPlayer",
			"local folder = Instance.new('Folder')",
			"folder.Name = 'f3liks_esp_highlights'",
			"folder.Parent = game:GetService('CoreGui')",
			"for _, plr in ipairs(Players:GetPlayers()) do",
			"\tif plr ~= lp and plr.Character then",
			"\t\tlocal hl = Instance.new('Highlight')",
			"\t\thl.FillTransparency = 0.65",
			"\t\thl.OutlineTransparency = 0",
			"\t\thl.Adornee = plr.Character",
			"\t\thl.Parent = folder",
			"\tend",
			"end",
			"print('[f3liks hub] Player highlights applied.')"
		}, "\n")
	else
		return table.concat({
			"-- Built by f3liks hub AI Builder",
			"-- Prompt: " .. tostring(rawPrompt),
			"local Players = game:GetService('Players')",
			"local lp = Players.LocalPlayer",
			"local char = lp.Character or lp.CharacterAdded:Wait()",
			"local hum = char:WaitForChild('Humanoid')",
			"hum.UseJumpPower = true",
			"hum.WalkSpeed = 32",
			"hum.JumpPower = 75",
			"print('[f3liks hub] Applied WalkSpeed=32 and JumpPower=75.')"
		}, "\n")
	end
end

generateBtn.MouseButton1Click:Connect(function()
	if isThinking then return end
	isThinking = true
	thinkRunId += 1
	local currentId = thinkRunId

	local delaySec = tonumber(stepDelayInput.Text) or 1.0
	delaySec = math.clamp(delaySec, 0.25, 4.0)
	local promptText = promptBox.Text ~= "" and promptBox.Text or "Custom utility script"

	local thoughts = {
		"[Step 1/5] Reading prompt: '" .. promptText .. "'",
		"[Step 2/5] Identifying target Roblox services (Players, RunService, Humanoid)...",
		"[Step 3/5] Checking character respawn & nil safety guards so nothing crashes...",
		"[Step 4/5] Designing clean toggle/parameter structure for mobile execution...",
		"[Step 5/5] Formatting final Luau code and syncing to output box..."
	}

	thoughtHeader.Text = "AI Thinking Process (Thinking...)"
	thoughtBox.Text = ""
	genScriptBox.Text = "-- Thinking in progress... waiting for steps to finish."
	generateBtn.Text = "Thinking..."

	task.spawn(function()
		local logLines = {}
		for i, line in ipairs(thoughts) do
			if thinkRunId ~= currentId then return end
			table.insert(logLines, string.format("%.1fs  %s", (i - 1) * delaySec, line))
			thoughtBox.Text = table.concat(logLines, "\n")
			thoughtBox.CursorPosition = #thoughtBox.Text + 1
			task.wait(delaySec)
		end

		if thinkRunId ~= currentId then return end
		local builtCode = buildScriptFromPrompt(promptText)
		table.insert(logLines, string.format("%.1fs  Done! Script generated.", #thoughts * delaySec))
		thoughtBox.Text = table.concat(logLines, "\n")
		thoughtHeader.Text = "AI Thinking Process (Completed)"
		genScriptBox.Text = builtCode
		setOutputCode(builtCode, "AI Builder wrote a new script to Tools tab.")
		generateBtn.Text = "Think & Build"
		isThinking = false
	end)
end)

